// ParReduce-Sum layout: 4-PE linear tree reduction.
// PE arrangement: 4x1 horizontal strip. Each PE holds N/4 elements,
// computes a local partial sum, then tree-reduces east-to-west:
//   Step 1: PE3->PE2 (C_W), PE1->PE0 (C_W)  [2 independent sends]
//   Step 2: PE2->PE0 (C_W2)                   [final reduction]
// Result lands on PE(0,0).

param n_per_pe: u16;   // elements per PE
param width: i16 = 4;  // 4 PEs wide
param height: i16 = 1; // 1 PE tall

// Colors for tree reduction phases
const C_PHASE1: color = @get_color(8);   // phase 1: odd->even
const C_PHASE2: color = @get_color(9);   // phase 2: PE2->PE0

const memcpy = @import_module("<memcpy/get_params>", .{
  .width = width,
  .height = height,
});

layout {
  @set_rectangle(width, height);

  var px: i16 = 0;
  while (px < width) : (px += 1) {
    const memcpy_params = memcpy.get_params(px);
    @set_tile_code(px, 0, "pe.csl", .{
      .memcpy_params = memcpy_params,
      .n_per_pe = n_per_pe,
      .px = px,
      .width = width,
      .C_PHASE1 = C_PHASE1,
      .C_PHASE2 = C_PHASE2,
    });
  }

  // Phase 1 routing: PE3->PE2, PE1->PE0 (data travels WEST on C_PHASE1)
  // PE3: sender, RAMP->WEST
  @set_color_config(3, 0, C_PHASE1, .{ .routes = .{ .rx = .{ RAMP }, .tx = .{ WEST }}});
  // PE2: receiver from east, EAST->RAMP
  @set_color_config(2, 0, C_PHASE1, .{ .routes = .{ .rx = .{ EAST }, .tx = .{ RAMP }}});
  // PE1: sender, RAMP->WEST
  @set_color_config(1, 0, C_PHASE1, .{ .routes = .{ .rx = .{ RAMP }, .tx = .{ WEST }}});
  // PE0: receiver from east, EAST->RAMP
  @set_color_config(0, 0, C_PHASE1, .{ .routes = .{ .rx = .{ EAST }, .tx = .{ RAMP }}});

  // Phase 2 routing: PE2->PE0 (data travels WEST on C_PHASE2, passes through PE1)
  // PE2: sender, RAMP->WEST
  @set_color_config(2, 0, C_PHASE2, .{ .routes = .{ .rx = .{ RAMP }, .tx = .{ WEST }}});
  // PE1: passthrough, EAST->WEST
  @set_color_config(1, 0, C_PHASE2, .{ .routes = .{ .rx = .{ EAST }, .tx = .{ WEST }}});
  // PE0: receiver, EAST->RAMP
  @set_color_config(0, 0, C_PHASE2, .{ .routes = .{ .rx = .{ EAST }, .tx = .{ RAMP }}});

  @export_name("x", [*]f32, true);
  @export_name("result", [*]f32, true);
  @export_name("maxmin_time", [*]f32, true);
  @export_name("compute", fn()void);
}
