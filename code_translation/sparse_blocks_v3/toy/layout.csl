// Storage-format measurement toy: one PE.
param N: u16;
param CAP: u16;
param DENSE: u16;
param NB: u16;

const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });

layout {
  @set_rectangle(1, 1);
  @set_tile_code(0, 0, "pe.csl", .{ .memcpy_params = memcpy.get_params(0), .N = N, .CAP = CAP, .DENSE = DENSE, .NB = NB });
  @export_name("rp", [*]u32, true);
  @export_name("ci", [*]u32, true);
  @export_name("va", [*]f32, true);
  @export_name("xv", [*]f32, true);
  @export_name("yv", [*]f32, true);
  @export_name("ctl", [*]u32, true);
  @export_name("tbuf", [*]f32, true);
  @export_name("compute", fn()void);
}
