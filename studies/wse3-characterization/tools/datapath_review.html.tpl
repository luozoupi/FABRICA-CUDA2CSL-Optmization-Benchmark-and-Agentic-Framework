<style>
:root{--paper:#fff;--bg:#f5f5f0;--ink:#293c4e;--muted:#6f8192;--line:#dce3e5;--accent:#0b8874;--soft:#eaf5f0;--amber:#bd701c}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--bg);font:15px system-ui,sans-serif;line-height:1.6}main{max-width:1400px;padding:34px;margin:auto}header{padding:20px 0 25px;border-bottom:1px solid var(--line)}h1{font-size:44px;font-weight:550;letter-spacing:-1px;margin:8px 0}h2{font-size:23px;margin:8px 0}h3{font-size:17px;margin:8px 0}p{margin:8px 0 16px}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--accent);font-weight:750}.muted,small{color:var(--muted)}.card{padding:24px;border:1px solid var(--line);border-radius:10px;background:var(--paper);margin:18px 0;min-width:0}.controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap}button,select{font:inherit;color:inherit;border:1px solid var(--line);border-radius:5px;background:var(--paper);padding:8px 12px;cursor:pointer}button:hover{border-color:var(--accent)}button.active{color:var(--accent);background:var(--soft);border-color:var(--accent)}select{max-width:100%}.controls select{flex:1;min-width:220px}input{accent-color:var(--accent)}.two{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:18px}.two>.card{margin:0}code,.mono{font:12px ui-monospace,monospace;overflow-wrap:anywhere}.scroll{overflow:auto;max-width:100%}table{border-collapse:collapse;width:100%;font-size:12px}td,th{border-bottom:1px solid var(--line);padding:8px;text-align:left}th{font-size:10px;text-transform:uppercase;letter-spacing:.6px;color:var(--muted)}td{white-space:nowrap}tr.selected{background:var(--soft)}.badge{display:inline-block;background:var(--soft);color:var(--accent);border-radius:4px;padding:4px 8px;font-size:11px}.limit{border-left:3px solid var(--amber);padding:8px 15px;background:#fff7eb;font-size:12px}.diagram{width:100%;min-width:620px;height:auto}.diagram text{font:13px system-ui,sans-serif;fill:var(--ink)}.diagram .sub{font-size:10px;fill:var(--muted)}.diagram rect{fill:var(--paper);stroke:var(--line);stroke-width:2}.diagram .block.active rect{stroke:var(--accent);fill:var(--soft)}.diagram .wire{fill:none;stroke:var(--line);stroke-width:2}.diagram .wire.active{stroke:var(--accent);stroke-width:3}.diagram .control{stroke-dasharray:5 4}.diagram .unit rect{rx:20}.record td{font:11px ui-monospace,monospace}.timeline td{padding:2px;min-width:22px;height:24px;text-align:center;border:0}.timeline .label{position:sticky;left:0;background:var(--paper);text-align:left;max-width:300px;overflow:hidden;text-overflow:ellipsis;font:11px ui-monospace,monospace}.timeline button{border:0;padding:1px 5px;font:11px ui-monospace,monospace}.timeline .v{background:var(--accent);color:white}.timeline .d{background:#e7e4f5;color:#615482}.timeline .s{background:#fff1dc;color:var(--amber)}.timeline .chosen{outline:2px solid var(--ink);outline-offset:-2px}.stat{font-size:26px;color:var(--accent)}.stats{display:flex;gap:35px;flex-wrap:wrap}.stat small{display:block;font:11px system-ui,sans-serif}details{margin:18px 0}summary{cursor:pointer;font-size:12px}a{color:var(--accent)}.values{max-height:260px;overflow:auto}.sources{max-height:300px;overflow:auto;font:11px ui-monospace,monospace}.span{grid-column:1/-1}#clock{font:20px ui-monospace,monospace}footer{font-size:12px;color:var(--muted);padding:25px 0}button:focus-visible,select:focus-visible{outline:3px solid #d48634}ul{padding-left:20px}#summary-table td{white-space:normal}
@media(max-width:900px){main{padding:16px}.two{grid-template-columns:1fr}h1{font-size:34px}.card{padding:16px}.controls{gap:8px}.controls select{width:100%}}
</style>
<main>
<header><span class="eyebrow">WSE-3 / DATAPATH REVIEW</span><h1>Inside the processing element.</h1><p>Compare GEMM, Add, and memory operations using the same functional datapath and recorded instruction timeline.</p><span class="badge">Re-audited simulator records</span> <span class="badge">Independent silicon bank comparison</span></header>
<section class="card"><div class="stats" id="stats"></div><p class="muted">The diagram shows which resources an instruction uses. Physical ports, forwarding muxes, stage 4–5 functions, fetch timing, and writeback timing remain unobserved.</p></section>
<section class="card"><span class="eyebrow">01 / PICK A WORKLOAD</span><div class="controls"><select id="scene" aria-label="Workload"></select><button id="prev">Previous instruction</button><button id="next">Next instruction</button></div><h2 id="title"></h2><p id="note"></p><div class="controls"><label for="cycle">Recorded cycle</label><input id="cycle" type="range" style="flex:1;min-width:140px"><b id="clock"></b></div><p class="muted"><small>Choose an instruction row or a timeline marker. The cycle slider reveals simultaneous observations; it does not animate invented internal stages.</small></p></section>
<div class="two">
<section class="card"><span class="eyebrow">02 / FUNCTIONAL DATAPATH</span><h2 id="instruction"></h2><div class="scroll"><svg class="diagram" viewBox="0 0 850 430" role="img" aria-label="Functional PE datapath">
<defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0L10 5L0 10" fill="#6f8192"/></marker></defs>
<g marker-end="url(#arrow)">
<path data-wire="sequencer gpr" class="wire control" d="M185 75H260V150H310"/>
<path data-wire="sram gpr" class="wire" d="M200 205H265V180H310"/>
<path data-wire="gpr sram" class="wire" d="M310 220H250V240H200"/>
<path data-wire="gpr scalar" class="wire" d="M470 170H560"/>
<path data-wire="scalar gpr" class="wire" d="M635 230V270H390V230"/>
<path data-wire="descriptor dsr" class="wire control" d="M185 360H245"/>
<path data-wire="dsr address" class="wire control" d="M395 360H440"/>
<path data-wire="address stream" class="wire control" d="M580 360H650"/>
<path data-wire="sram stream" class="wire" d="M115 265V295H725V330"/>
<path data-wire="stream sram" class="wire" d="M720 395V418H65V265"/>
<path data-wire="gpr stream" class="wire" d="M470 210H505V310H680V330"/>
<path data-wire="stream gpr" class="wire" d="M650 375H610V285H365V230"/>
<path data-wire="scalar flags" class="wire" d="M640 135V75H700"/>
<path data-wire="flags sequencer" class="wire control" d="M765 45V20H115V45"/>
</g>
<g class="block" data-block="sequencer"><rect x="35" y="45" width="150" height="60" rx="7"/><text x="48" y="69">PC / task selection</text><text class="sub" x="48" y="89">control flow; fetch untraced</text></g>
<g class="block" data-block="sram"><rect x="35" y="170" width="165" height="95" rx="7"/><text x="48" y="198">Local SRAM</text><text class="sub" x="48" y="219">data and stack locations</text><text class="sub" x="48" y="240">physical banks not drawn</text></g>
<g class="block" data-block="gpr"><rect x="310" y="135" width="160" height="95" rx="7"/><text x="325" y="165">Scalar registers</text><text class="sub" x="325" y="187">r / d / sp operand names</text><text class="sub" x="325" y="208">read / write times unknown</text></g>
<g class="block unit" data-block="scalar"><rect x="560" y="135" width="170" height="95"/><text x="580" y="165">Integer / FP function</text><text class="sub" x="580" y="187">arithmetic / address math</text><text class="sub" x="580" y="208">physical unit sharing unknown</text></g>
<g class="block" data-block="flags"><rect x="700" y="45" width="125" height="60" rx="7"/><text x="715" y="70">Condition flags</text><text class="sub" x="715" y="91">predicate / branch</text></g>
<g class="block" data-block="descriptor"><rect x="35" y="330" width="150" height="65" rx="7"/><text x="47" y="354">Descriptor storage</text><text class="sub" x="47" y="376">control words, not data</text></g>
<g class="block" data-block="dsr"><rect x="245" y="330" width="150" height="65" rx="7"/><text x="260" y="354">DSR files</text><text class="sub" x="260" y="376">dest / src0 / src1</text></g>
<g class="block" data-block="address"><rect x="440" y="330" width="140" height="65" rx="7"/><text x="454" y="354">Address generation</text><text class="sub" x="454" y="376">base / extent / stride</text></g>
<g class="block unit" data-block="stream"><rect x="650" y="330" width="175" height="65"/><text x="664" y="354">DSD operation / lanes</text><text class="sub" x="664" y="376">copy / fill / add / reduction</text></g>
</svg></div><p class="muted"><small>Green: selected instruction’s functional resource path. Dashed: descriptor or control role. Lines do not imply separate physical buses, stage order, or measured port counts. Fabric queues are outside these local-compute windows.</small></p><div id="resources"></div></section>
<section class="card"><span class="eyebrow">03 / OPERANDS AND TIMING</span><div id="timing"></div><h3>All operand-bearing S6 records</h3><div id="values" class="scroll values"></div><p class="muted"><small>Loads/stores are shown as bits with type interpretations. The mnemonic alone does not establish a tensor’s type. An S6 result is an observation, not a measured register-writeback timestamp.</small></p><details><summary>Every raw record reference for this instruction</summary><div class="scroll" id="raw"></div></details><p class="mono" id="source"></p></section>
</div>
<section class="card"><span class="eyebrow">04 / INSTRUCTION × CYCLE</span><h2>Observed stages only.</h2><p><span class="badge">D: dispatch / S3</span> <span class="badge">V: S6 operand payload</span> <span class="badge">s: S6 without operand payload</span></p><p class="muted"><small>Blank means no selected record at that cycle. It does not mean execute idle. Normal instructions can have both payload-free and payload-bearing records in the same cycle. Every dispatched instruction in this local window is retained, including runtime or unclassified instructions.</small></p><div class="scroll" id="timeline"></div><h3>Instruction sequence</h3><div class="scroll" id="instructions"></div></section>
<section class="card"><span class="eyebrow">05 / CONTROLLED COMPARISONS</span><h2>Which dependencies change the delay?</h2><p>Values below are recomputed from raw records and checked against the saved spacing sweeps. K counts inserted NOPs. “Bubble” is excess dispatch spacing beyond all intervening instructions; S3→V uses the first operand-bearing record.</p><div class="scroll" id="sweeps"></div><p class="limit">The DSR operation’s S3→V = 4 remains in the prepared-descriptor control. Only the disappearing dispatch bubble is tied to the last descriptor load. The f16 and i16 assembly-chain cases check markers and timing; they have no stored numerical result check.</p></section>
<section class="card"><span class="eyebrow">06 / GEMM AND MEMORY RESULTS</span><h2>The workload changes what the measurement means.</h2><div class="scroll" id="gemms"></div><div class="scroll" id="memory"></div><p class="limit">“Read” drains a vector into a scalar destination; it measures that destination bottleneck. Copy and fill use vector destinations. These finite-workload rates include setup and loop overhead. A scalar teaching GEMM is not a measurement of optimized DSD GEMM peak throughput.</p><h3>Silicon alignment check</h3><div class="scroll" id="banks"></div><p class="muted"><small>Accepted, non-warmup hardware trials from the retained ledger. This is a separate calibration workload, not the simulator bank probe’s binary. It establishes an alignment sensitivity on silicon; it does not identify an internal port or conflict mechanism.</small></p></section>
<section class="card"><span class="eyebrow">07 / EVIDENCE AND OPEN QUESTIONS</span><h2>What remains unresolved</h2><ul><li>Exact fetch, register-read, SRAM-access and writeback cycles; roles of unrecorded intermediate stages.</li><li>Forwarding topology, store visibility mechanism, register aliasing, memory port arbitration and queue depth.</li><li>How 32-bit load/store hazards compare with the controlled 16-bit sweep.</li><li>Which observed rules carry from simulator to silicon and across concurrent microthreads.</li></ul><p>Next decisive probes: same-address versus different-address stores/loads at both widths; f32 dependent chains with register-only and spill/reload variants; DSR readiness with matched prepared controls; bank alignment on silicon with verified ELF placement.</p><p>Documented programming model: <a href="https://sdk.cerebras.ai/csl/language/dsrs">DSR files</a> and <a href="https://sdk.cerebras.ai/csl/language/dsds">DSD operands</a>. The diagram’s physical interpretation remains bounded by the retained traces.</p><button id="export">Export reviewed data</button><details><summary>Capture identity and SHA-256 hashes</summary><div class="sources" id="sources"></div></details></section>
<footer>Native SVG + HTML · works offline · no WebGL · generated by tools/datapath_review.py</footer></main>
<script id="review-data" type="application/json">__DATA__</script>
<script>
const data=JSON.parse(document.getElementById('review-data').textContent),$=id=>document.getElementById(id),esc=x=>String(x??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const table=(headers,rows)=>`<table><thead><tr>${headers.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
let sceneIndex=0,index=0,cycle=0;
$('stats').innerHTML=`<div class="stat">${data.audit.gemm_products}<small>GEMM products rematched</small></div><div class="stat">${data.audit.sweep_pairs}<small>dependency pairs rechecked</small></div><div class="stat">${Object.keys(data.audit.captures).length}<small>raw captures reviewed</small></div>`;
$('scene').innerHTML=data.scenes.map((s,i)=>`<option value="${i}">${esc(s.title)}</option>`).join('');
function selectScene(){sceneIndex=+$('scene').value;const s=data.scenes[sceneIndex];index=s.instructions.findIndex(i=>i.uid===s.focus_uid);cycle=s.instructions[index].v_first??s.instructions[index].d;render();}
function render(){const s=data.scenes[sceneIndex],ins=s.instructions[index];$('title').textContent=s.title;$('note').textContent=s.note;$('instruction').textContent=ins.text;$('source').textContent=`${s.source} · tile ${ins.tile} · UID ${ins.uid} · PC 0x${ins.pc.toString(16)} · ${ins.origin}`;
const min=Math.min(...s.instructions.map(i=>i.d)),max=Math.max(...s.instructions.map(i=>i.v_last??i.d));$('cycle').min=min;$('cycle').max=max;$('cycle').value=cycle;$('clock').textContent=cycle;
const active=new Set(),wires=new Set();function path(...nodes){nodes.forEach(n=>active.add(n));for(let k=1;k<nodes.length;k++)wires.add(nodes[k-1]+' '+nodes[k]);}
const has=(arr,k)=>arr.some(r=>r[0]===k);
if(ins.unit==='dsr-load')path('descriptor','dsr');
else if(ins.unit==='lanes'){path('dsr','address','stream');if(has(ins.reads,'sram-stream'))path('sram','stream');if(has(ins.writes,'sram-stream'))path('stream','sram');if(has(ins.reads,'gpr'))path('gpr','stream');if(has(ins.writes,'gpr'))path('stream','gpr');}
else if(ins.unit==='load')path('sram','gpr');else if(ins.unit==='store'){if(has(ins.reads,'gpr'))path('gpr','sram');else active.add('sram');}
else if(ins.unit==='sequencer'||ins.unit==='task')active.add('sequencer');
else if(ins.unit==='imm')active.add('gpr');
else if(ins.unit!=='none'){if(has(ins.reads,'gpr'))path('gpr','scalar');if(has(ins.writes,'gpr'))path('scalar','gpr');}
if(has(ins.reads,'cflag'))path('flags','sequencer');if(has(ins.writes,'cflag'))path('scalar','flags');
document.querySelectorAll('[data-block]').forEach(el=>el.classList.toggle('active',active.has(el.dataset.block)));document.querySelectorAll('[data-wire]').forEach(el=>el.classList.toggle('active',wires.has(el.dataset.wire)));
$('resources').innerHTML=`<p class="mono">Read: ${ins.reads.map(r=>esc(r.join(': '))).join(' · ')||'—'}<br>Write: ${ins.writes.map(r=>esc(r.join(': '))).join(' · ')||'—'}</p><small>Assembly resource names; indirect addresses and r/d aliases are not resolved into a complete memory-dependency graph.</small>`;
$('timing').innerHTML=`<h2>S3 → value: ${ins.dx_value??'unknown'} cycles</h2><p>Dispatch ${ins.dispatch.map(d=>d.cycle).join(', ')} · S3 ${ins.s3??'—'}<br>First / last operand payload ${ins.v_first??'—'} / ${ins.v_last??'—'}</p><p class="mono">Task ${ins.task} · microthread ${ins.ut===255?'none reported':ins.ut} · requested elements ${ins.elements}</p>`;
const vals=ins.execute.filter(e=>e.has_payload);$('values').innerHTML=table(['Cycle','Element','Lane','Result','src0','src1','src2'],vals.map(v=>[v.cycle,v.element,v.lane,...['dest','src0','src1','src2'].map(k=>esc(v.display[k])||'—')]));
$('raw').innerHTML=table(['Kind','Cycle','JSONL row'],[...ins.dispatch.map(e=>['dispatch',e.cycle,e.row]),...ins.decode.map(e=>['S3',e.cycle,e.row]),...ins.execute.map(e=>[e.has_payload?'S6 payload':'S6 no operand payload',e.cycle,e.row])]);
$('instructions').innerHTML=`<table><thead><tr><th>Instruction</th><th>UID</th><th>PC</th><th>D</th><th>V first</th><th>V last</th><th>S3→V</th></tr></thead><tbody>${s.instructions.map((i,n)=>`<tr class="${n===index?'selected':''}"><td><button data-ins="${n}">${esc(i.text)}</button></td><td>${i.uid}</td><td>0x${i.pc.toString(16)}</td><td>${i.d}</td><td>${i.v_first??'—'}</td><td>${i.v_last??'—'}</td><td>${i.dx_value??'—'}</td></tr>`).join('')}</tbody></table>`;
const times=Array.from({length:max-min+1},(_,i)=>min+i);
$('timeline').innerHTML=`<table class="timeline"><thead><tr><th></th>${times.map(c=>`<th>${c}</th>`).join('')}</tr></thead><tbody>${s.instructions.map((i,n)=>`<tr><td class="label">${esc(i.text)}</td>${times.map(c=>{const v=i.execute.some(e=>e.cycle===c&&e.has_payload),d=i.dispatch.some(e=>e.cycle===c)||i.decode.some(e=>e.cycle===c),r=i.execute.some(e=>e.cycle===c);const kind=v?'v':d?'d':r?'s':'';return `<td class="${c===cycle?'chosen':''}">${kind?`<button data-ins="${n}" data-cycle="${c}" class="${kind}">${v?'V':d?'D':'s'}</button>`:''}</td>`;}).join('')}</tr>`).join('')}</tbody></table>`;
document.querySelectorAll('[data-ins]').forEach(b=>b.onclick=()=>{index=+b.dataset.ins;const i=s.instructions[index];cycle=b.dataset.cycle?+b.dataset.cycle:i.v_first??i.d;render();});$('prev').disabled=index===0;$('next').disabled=index===s.instructions.length-1;
}
$('scene').onchange=selectScene;$('prev').onclick=()=>{index--;cycle=data.scenes[sceneIndex].instructions[index].v_first??data.scenes[sceneIndex].instructions[index].d;render();};$('next').onclick=()=>{index++;cycle=data.scenes[sceneIndex].instructions[index].v_first??data.scenes[sceneIndex].instructions[index].d;render();};$('cycle').oninput=e=>{cycle=+e.target.value;render();};
$('sweeps').innerHTML=table(['Class','K','Dispatch bubble','S3→V','Numerical check'],Object.entries(data.sweeps).map(([k,v])=>[esc(k),v.rows.map(r=>r.prepared?'prepared':r.k).join(', '),v.rows.map(r=>r.bubble).join(', '),v.rows.map(r=>r.dx_value??'—').join(', '),v.verification.checked?`${v.verification.checked} values`:'timing + markers only']));
$('gemms').innerHTML=table(['GEMM','PEs','Products / output cells','History cycles per PE','Control cycles per PE','FMULS S3→V counts','FADDS S3→V counts'],data.gemm.map(g=>[g.id.toUpperCase(),g.p*g.p,`${g.products} / ${g.outputs}`,g.history_cycles.join(', '),g.control_cycles.join(', '),esc(JSON.stringify(g.modes.history.FMULS.dx_value)),esc(JSON.stringify(g.modes.history.FADDS.dx_value))]));
$('memory').innerHTML=table(['Memory workload','Work elements','Cycles','Elements / cycle'],data.memory.rows.filter(r=>['read_12288','write_12288','copy_4096'].includes(r.name)||r.family==='rstride').map(r=>[esc(r.name),r.total_elems,r.cycles,r.elem_per_cyc]));
$('banks').innerHTML=table(['Hardware calibration case','Trials','Median cycles'],Object.entries(data.bank_ledger).map(([k,v])=>[esc(k),v.trials,v.median]));
$('sources').innerHTML=Object.entries(data.sources).map(([p,v])=>`<p>${esc(p)}<br>${v.sha256}</p>`).join('');
$('export').onclick=()=>{const url=URL.createObjectURL(new Blob([JSON.stringify(data,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='datapath_review.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};selectScene();
</script></html>
