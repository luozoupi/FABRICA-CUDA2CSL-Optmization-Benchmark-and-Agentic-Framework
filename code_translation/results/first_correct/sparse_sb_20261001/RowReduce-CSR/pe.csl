param memcpy_params;
// === SLOT: EXTRA_PARAMS ===
// Declare any compile-time params your kernel needs from layout.csl
param nrows: u16;
param max_nnz: u16;
param iters: u16;

const EXIT: local_task_id = @get_local_task_id(9);
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

// === SLOT: EXTRA_IMPORTS ===
// (no extra imports needed)

const timestamp = @import_module("<time>");
var tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);
var tsc_end_buf   = @zeros([timestamp.tsc_size_words]u16);
var timer_buf = @zeros([3]f32);
var ptr_timer_buf: [*]f32 = &timer_buf;

// === SLOT: DATA_BUFFERS ===
// CSR row offsets: [nrows+1] u32
var row_ptr_array = @zeros([nrows + 1]u32);
var ptr_row_ptr: [*]u32 = &row_ptr_array;

// Stored values: [max_nnz] f32
var val_array = @zeros([max_nnz]f32);
var ptr_val: [*]f32 = &val_array;

// Per-row sums: [nrows] f32
var y_array = @zeros([nrows]f32);
var ptr_y: [*]f32 = &y_array;

// Scalar total: [1] f32
var total_array = @zeros([1]f32);
var ptr_total: [*]f32 = &total_array;

// Single-cell accumulator for the DSD reduction.
var acc_scalar = @zeros([1]f32);

// Module-scope DSDs built once (dummy length 1); base/length patched per row
// at runtime via @set_dsd_base_addr / @set_dsd_length — the required idiom,
// since DSD length must NOT bake a runtime value into @get_dsd.
var row_dsd = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i| { 1 } -> val_array[i],
});
// Accumulator DSD with stride 0: every element folds into acc_scalar[0].
var acc_dsd = @get_dsd(mem1d_dsd, .{
    .tensor_access = |i| { 1 } -> acc_scalar[0],
});

// === SLOT: KERNEL_FUNCTION ===
// Per-row plus-monoid reduction (y[r] = sum of row r's stored values)
// plus full reduction (total = sum of all stored values).
fn row_reduce() void {
    var grand: f32 = 0.0;

    var r: u16 = 0;
    while (r < nrows) : (r += 1) {
        const start: u32 = row_ptr_array[r];
        const end: u32 = row_ptr_array[r + 1];
        const len: u32 = end - start;

        var acc: f32 = 0.0;
        if (len > 0) {
            // Reset the single-cell accumulator.
            acc_scalar[0] = 0.0;
            // Point the input DSD at this row's slice val[start:end] and patch
            // the length at runtime (stride stays 1 from the module-scope build).
            var rd = @set_dsd_base_addr(row_dsd, @ptrcast([*]f32, &val_array[start]));
            rd = @set_dsd_length(rd, @as(u16, len));
            // The accumulator DSD iterates the same number of times, folding into
            // acc_scalar[0] (stride 0 so every add accumulates into one cell).
            var ad = @set_dsd_length(acc_dsd, @as(u16, len));
            @fadds(ad, ad, rd);
            acc = acc_scalar[0];
        }

        y_array[r] = acc;
        grand += acc;
    }

    total_array[0] = grand;
}

fn compute() void {
    timestamp.enable_tsc();
    timestamp.get_timestamp(&tsc_start_buf);

    // === SLOT: KERNEL_CALL ===
    row_reduce();

    timestamp.get_timestamp(&tsc_end_buf);
    timestamp.disable_tsc();

    var lo_: u16 = 0;
    var hi_: u16 = 0;
    lo_ = tsc_start_buf[0]; hi_ = tsc_start_buf[1];
    timer_buf[0] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
    lo_ = tsc_start_buf[2]; hi_ = tsc_end_buf[0];
    timer_buf[1] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
    lo_ = tsc_end_buf[1]; hi_ = tsc_end_buf[2];
    timer_buf[2] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

    @activate(EXIT);
}

task f_exit() void {
    sys_mod.unblock_cmd_stream();
}

comptime {
    @bind_local_task(f_exit, EXIT);

    // === SLOT: EXPORT_SYMBOLS ===
    @export_symbol(ptr_row_ptr, "row_ptr");
    @export_symbol(ptr_val, "val");
    @export_symbol(ptr_y, "y");
    @export_symbol(ptr_total, "total");

    @export_symbol(ptr_timer_buf, "maxmin_time");
    @export_symbol(compute);
}