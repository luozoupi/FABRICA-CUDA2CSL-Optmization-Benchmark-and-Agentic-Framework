  sink[16] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[48] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[49] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[50] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_vdot_8();
  timestamp.get_timestamp(&tsc_e);
  sink[17] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[51] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[52] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[53] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_vdot_64();
  timestamp.get_timestamp(&tsc_e);
  sink[18] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[54] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[55] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[56] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_vdot_256();
  timestamp.get_timestamp(&tsc_e);
  sink[19] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[57] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[58] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[59] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_vdot_1024();
  timestamp.get_timestamp(&tsc_e);
  sink[20] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[60] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[61] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[62] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_vdot_2048();
  timestamp.get_timestamp(&tsc_e);
  sink[21] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[63] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[64] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[65] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_reduce_64();
  timestamp.get_timestamp(&tsc_e);
  sink[22] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[66] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[67] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[68] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_reduce_1024();
  timestamp.get_timestamp(&tsc_e);
  sink[23] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[69] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[70] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[71] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_reduce_2048();
  timestamp.get_timestamp(&tsc_e);
  sink[24] = @as(f32, acc);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[72] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[73] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[74] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.get_timestamp(&tsc_s);
  bench_axpy_2047();
  timestamp.get_timestamp(&tsc_e);
  sink[25] = @as(f32, y_arr[1]);

  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[75] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[76] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[77] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.disable_tsc();

  @activate(EXIT);
}

task f_exit() void { sys_mod.unblock_cmd_stream(); }

comptime {
  @bind_local_task(f_exit, EXIT);
  @export_symbol(ptr_timer_buf, "maxmin_time");
  @export_symbol(ptr_sink, "sink");
  @export_symbol(ptr_x_arr, "x_arr");
  @export_symbol(ptr_y_arr, "y_arr");
  @export_symbol(ptr_t_arr, "t_arr");
  @export_symbol(ptr_z_arr, "z_arr");
  @export_symbol(compute);
}
