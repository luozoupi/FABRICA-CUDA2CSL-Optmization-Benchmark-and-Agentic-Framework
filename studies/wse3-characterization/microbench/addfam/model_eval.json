 "rules": [
  {
   "id": "F1",
   "boundary": "CSL -> captured IR",
   "name": "straight-line statements lower one-to-one",
   "when": "any straight-line add over array elements",
   "result": "each statement contributes its own loads, add and store; nothing is shared between statements",
   "cases": [
    "base",
    "use_expr_twice",
    "operand_shared",
    "pair_independent"
   ],
   "tested": "verified for one to two statements over i16[64] arrays",
   "untested": "statement counts beyond two, and types other than i16",
   "evidence": "compiled"
  },
  {
   "id": "F2",
   "boundary": "CSL -> captured IR",
   "name": "a constant operand is already an IR immediate",
   "when": "exactly one operand is a source-level constant",
   "result": "`add i16 %x, 7`; the backend emits `add16.nf rD = rS, 0x7` with no load and no `movri`",
   "cases": [
    "const_one"
   ],
   "tested": "verified for the constant 7",
   "untested": "the immediate encoding boundary: no constant near the field width has been tried",
   "evidence": "compiled"
  },
  {
   "id": "F3",
   "boundary": "CSL -> captured IR",
   "name": "source constants are folded before capture",
   "when": "both operands are source-level constants",
   "result": "no `add` in the captured IR; the folded value appears in the `store`, and the backend materialises it with one `movri`",
   "cases": [
    "const_both"
   ],
   "tested": "verified for 3 + 7",
   "untested": "overflow behaviour at the i16 boundary",
   "evidence": "compiled"
  },
  {
   "id": "F4",
   "boundary": "CSL -> captured IR",
   "name": "DSD form, descriptor sharing and DSR indices are all chosen before capture",
   "when": "the add is written as `@add16` over `mem1d_dsd` operands",
   "result": "the captured IR holds the descriptor-load intrinsics and one arithmetic intrinsic whose NAME encodes the operand roles and whose ARGUMENTS are the DSR indices: `llvm.sdr.add16.ds0s1(1, 1, 1)` with three descriptor loads, against `llvm.sdr.add16.s0s0s1(0, 0, 1)` with two",
   "cases": [
    "dsd16",
    "W_dsd_inplace"
   ],
   "tested": "verified for a 16-element mem1d_dsd add, and for the same DSD value passed as both destination and source-0",
   "untested": "two separately constructed DSDs describing equivalent accesses; a destination aliasing source-1 rather than source-0",
   "evidence": "compiled",
   "note": "corrects an earlier version of this model, which placed descriptor elision and DSR assignment after the capture boundary and presented the two-descriptor form as a machine-code counterexample. It is visible in the IR."
  },
  {
