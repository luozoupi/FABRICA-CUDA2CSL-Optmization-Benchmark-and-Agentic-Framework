param n: i16;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });
layout {
  @set_rectangle(1, 1);
  @set_tile_code(0, 0, "shape.csl", .{
    .memcpy_params = memcpy.get_params(0), .n = n,
  });
  @export_name("C", [*]f16, true);
  @export_name("compute", fn()void);
}
