param dsdlen: i16;
const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });
layout {
  @set_rectangle(1, 1);
  @set_tile_code(0, 0, "pe_lit.csl", .{ .memcpy_params = memcpy.get_params(0), .dsdlen = dsdlen });
  @export_name("C", [*]f16, true);
  @export_name("compute", fn()void);
}
