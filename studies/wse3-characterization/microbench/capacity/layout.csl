// Single-PE capacity probe: allocate `words` u16 and find where cslc refuses.
param words: i16;

const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });

layout {
  @set_rectangle(1, 1);
  @set_tile_code(0, 0, "pe.csl", .{
    .memcpy_params = memcpy.get_params(0), .words = words,
  });
  @export_name("buf", [*]u16, true);
  @export_name("compute", fn()void);
}
