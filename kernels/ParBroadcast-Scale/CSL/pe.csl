// ParBroadcast-Scale PE: PE0 broadcasts alpha, all PEs scale local array.
// PE0 sends alpha on C_BCAST; PEs 1-3 receive from fabric.
// After receiving alpha, each PE does out[i] = alpha * x[i].

param memcpy_params: comptime_struct;
param n_per_pe: u16;
param px: i16;
param width: i16;
param C_BCAST: color;

const EXIT: local_task_id = @get_local_task_id(9);
const SCALE_TASK: local_task_id = @get_local_task_id(10);

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

var tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);
var tsc_end_buf   = @zeros([timestamp.tsc_size_words]u16);
var timer_buf = @zeros([3]f32);
var ptr_timer_buf: [*]f32 = &timer_buf;

var x_array = @zeros([n_per_pe]f32);
var out_array = @zeros([n_per_pe]f32);
var alpha_buf = @zeros([1]f32);
var recv_alpha = @zeros([1]f32);
var ptr_x: [*]f32 = &x_array;
var ptr_out: [*]f32 = &out_array;
var ptr_alpha: [*]f32 = &alpha_buf;

const alpha_send_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> alpha_buf[i] });
const alpha_recv_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> recv_alpha[i] });

const fab_bcast_out = @get_dsd(fabout_dsd, .{ .extent = 1, .fabric_color = C_BCAST, .output_queue = @get_output_queue(2) });
const fab_bcast_in  = @get_dsd(fabin_dsd,  .{ .extent = 1, .fabric_color = C_BCAST, .input_queue  = @get_input_queue(2) });

fn pack_timestamps() void {
  var lo_: u16 = 0; var hi_: u16 = 0;
  lo_ = tsc_start_buf[0]; hi_ = tsc_start_buf[1];
  timer_buf[0] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_start_buf[2]; hi_ = tsc_end_buf[0];
  timer_buf[1] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_end_buf[1]; hi_ = tsc_end_buf[2];
  timer_buf[2] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
}

fn do_scale(a: f32) void {
  var i: u16 = 0;
  while (i < n_per_pe) : (i += 1) {
    out_array[i] = a * x_array[i];
  }
}

fn compute() void {
  timestamp.enable_tsc();
  timestamp.get_timestamp(&tsc_start_buf);

  if (px == 0) {
    // PE0 has alpha from host. Broadcast it east, then scale locally.
    @fmovs(fab_bcast_out, alpha_send_dsd, .{ .async = true });
    do_scale(alpha_buf[0]);
    timestamp.get_timestamp(&tsc_end_buf);
    timestamp.disable_tsc();
    pack_timestamps();
    @activate(EXIT);
  } else {
    // PEs 1-3: receive alpha from broadcast, then scale
    @fmovs(alpha_recv_dsd, fab_bcast_in, .{ .async = true, .activate = SCALE_TASK });
  }
}

task scale_after_recv() void {
  do_scale(recv_alpha[0]);
  timestamp.get_timestamp(&tsc_end_buf);
  timestamp.disable_tsc();
  pack_timestamps();
  @activate(EXIT);
}

task f_exit() void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(f_exit, EXIT);
  @bind_local_task(scale_after_recv, SCALE_TASK);

  if (@is_arch("wse3")) {
    @initialize_queue(@get_output_queue(2), .{ .color = C_BCAST });
    @initialize_queue(@get_input_queue(2),  .{ .color = C_BCAST });
  }

  @export_symbol(ptr_x, "x");
  @export_symbol(ptr_out, "out");
  @export_symbol(ptr_alpha, "alpha");
  @export_symbol(ptr_timer_buf, "maxmin_time");
  @export_symbol(compute);
}
