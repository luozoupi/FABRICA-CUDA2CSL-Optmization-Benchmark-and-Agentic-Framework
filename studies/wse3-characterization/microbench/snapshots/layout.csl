const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });
layout {
  @set_rectangle(1, 1);
  @set_tile_code(0, 0, "single.csl", .{ .memcpy_params = memcpy.get_params(0) });
  @export_name("A", [*]u16, true);
  @export_name("B", [*]u16, true);
  @export_name("C", [*]u16, true);
  @export_name("compute", fn()void);
}
