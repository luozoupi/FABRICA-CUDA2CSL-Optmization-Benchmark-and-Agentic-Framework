// DSD extent probe.  Arrays are fixed at the maximum length so that only the
// requested DSD extent varies between variants.
param memcpy_params;

const EXIT: local_task_id = @get_local_task_id(9);
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

var A = @zeros([22000]f16);
var ptr_C: [*]f16 = &A;

fn bench_0() void {
  const d0 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{4096} -> A[i] });
  const d1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{4096} -> A[i] });
  const d2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{4096} -> A[i] });
  @fmach(d2, d0, d1, @as(f16, 1.0009765625));
}

fn bench_1() void {
  const d0 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{8192} -> A[i] });
  const d1 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{8192} -> A[i] });
  const d2 = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{8192} -> A[i] });
