fn bench_loop() void {
  var rr: u16 = 0;
  while (rr < 16) : (rr += 1) {
    var i: u16 = 0;
    while (i < 512) : (i += 1) { s = s + ia[i]; }
  }
}

fn guarded(flags: *[512]i16) void {
  var rr: u16 = 0;
  while (rr < 16) : (rr += 1) {
    var i: u16 = 0;
    while (i < 512) : (i += 1) {
      if (flags.*[i] != 0) {
        s = s + ia[i];
        s = s ^ (s << 1);
        s = s + 3;
      }
    }
  }
}
fn bench_true() void { guarded(&f_true); }
fn bench_false() void { guarded(&f_false); }
fn bench_alt() void { guarded(&f_alt); }

fn compute() void {
  var lo_: u16 = 0;
  var hi_: u16 = 0;
  timestamp.enable_tsc();

  s = 0;
  timestamp.get_timestamp(&tsc_s);
  bench_straight();
  timestamp.get_timestamp(&tsc_e);
  sink[0] = @as(f32, s);
  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[0] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[1] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[2] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  s = 0;
  timestamp.get_timestamp(&tsc_s);
  bench_loop();
  timestamp.get_timestamp(&tsc_e);
  sink[1] = @as(f32, s);
  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[3] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[4] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[5] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  s = 0;
  timestamp.get_timestamp(&tsc_s);
  bench_true();
  timestamp.get_timestamp(&tsc_e);
  sink[2] = @as(f32, s);
  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[6] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[7] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[8] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  s = 0;
  timestamp.get_timestamp(&tsc_s);
  bench_false();
  timestamp.get_timestamp(&tsc_e);
  sink[3] = @as(f32, s);
  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[9] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[10] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[11] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  s = 0;
  timestamp.get_timestamp(&tsc_s);
  bench_alt();
  timestamp.get_timestamp(&tsc_e);
  sink[4] = @as(f32, s);
  lo_ = tsc_s[0]; hi_ = tsc_s[1];
  timer_buf[12] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_s[2]; hi_ = tsc_e[0];
  timer_buf[13] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_e[1]; hi_ = tsc_e[2];
  timer_buf[14] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  timestamp.disable_tsc();
  @activate(EXIT);
}

task f_exit() void { sys_mod.unblock_cmd_stream(); }

comptime {
  @bind_local_task(f_exit, EXIT);
