// D3: integer elementwise add over DSDs.
var a = @zeros([64]i16);
var b = @zeros([64]i16);
var c = @zeros([64]i16);
const a_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{64} -> a[i] });
const b_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{64} -> b[i] });
const c_d = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{64} -> c[i] });
fn f() void { @add16(c_d, a_d, b_d); }

