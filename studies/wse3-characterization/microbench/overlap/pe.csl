param memcpy_params;
const EXIT: local_task_id = @get_local_task_id(9);
const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

var iaL = @zeros([2048]i16); var ibL = @zeros([2048]i16);
var icA = @zeros([2048]i16); var icC = @zeros([2048]i16);
var ia  = @zeros([64]i16);  var ib = @zeros([64]i16);
var outsc = @zeros([4]i16);

var p_iaL: [*]i16 = &iaL; var p_ibL: [*]i16 = &ibL; var p_icA: [*]i16 = &icA; var p_icC: [*]i16 = &icC;
var p_ia: [*]i16 = &ia; var p_ib: [*]i16 = &ib; var p_outsc: [*]i16 = &outsc;

const iaLd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2048} -> iaL[i] });
const ibLd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2048} -> ibL[i] });
const icAd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2048} -> icA[i] });
const icCd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{2048} -> icC[i] });

// region A: one long DSD hardware loop, nothing else
fn region_a() void {
  @add16(icAd, iaLd, ibLd);
  @activate(EXIT);
}

