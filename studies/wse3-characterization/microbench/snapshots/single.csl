param memcpy_params;
const sys = @import_module("<memcpy/memcpy>", memcpy_params);
var A = @zeros([4]u16);
var B = @zeros([4]u16);
var C = @zeros([4]u16);
var pa: [*]u16 = &A;
var pb: [*]u16 = &B;
var pc: [*]u16 = &C;
fn compute() void {
  C[0] = A[0] + B[0];
  C[1] = A[1] + B[1];
  sys.unblock_cmd_stream();
}
comptime {
  @export_symbol(pa, "A");
  @export_symbol(pb, "B");
  @export_symbol(pc, "C");
  @export_symbol(compute);
}
