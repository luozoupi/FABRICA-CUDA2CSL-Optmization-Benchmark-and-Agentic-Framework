param memcpy_params: comptime_struct;
param n_per_pe: u16;
param px: i16;
param C_REDUCE: color;

const EXIT: local_task_id = @get_local_task_id(9);
const RECV_DONE: local_task_id = @get_local_task_id(10);

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

var tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);
var tsc_end_buf   = @zeros([timestamp.tsc_size_words]u16);
var timer_buf = @zeros([3]f32);
var ptr_timer_buf: [*]f32 = &timer_buf;

var x_array = @zeros([n_per_pe]f32);
var result_buf = @zeros([1]f32);
var ptr_x: [*]f32 = &x_array;
var ptr_result: [*]f32 = &result_buf;

var local_sum_arr = @zeros([1]f32);
var recv_arr = @zeros([1]f32);

const local_sum_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> local_sum_arr[i] });
const recv_dsd      = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{1} -> recv_arr[i] });

const fab_out = @get_dsd(fabout_dsd, .{ .extent = 1, .fabric_color = C_REDUCE, .output_queue = @get_output_queue(2) });
const fab_in  = @get_dsd(fabin_dsd,  .{ .extent = 1, .fabric_color = C_REDUCE, .input_queue  = @get_input_queue(2) });

fn pack_timestamps() void {
  var lo_: u16 = 0; var hi_: u16 = 0;
  lo_ = tsc_start_buf[0]; hi_ = tsc_start_buf[1];
  timer_buf[0] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_start_buf[2]; hi_ = tsc_end_buf[0];
  timer_buf[1] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
  lo_ = tsc_end_buf[1]; hi_ = tsc_end_buf[2];
  timer_buf[2] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));
}

fn compute() void {
  timestamp.enable_tsc();
  timestamp.get_timestamp(&tsc_start_buf);

  var acc: f32 = 0.0;
  var i: u16 = 0;
  while (i < n_per_pe) : (i += 1) {
    acc += x_array[i];
  }
  local_sum_arr[0] = acc;

  if (px == 1) {
    @fmovs(fab_out, local_sum_dsd, .{ .async = true });
    timestamp.get_timestamp(&tsc_end_buf);
    timestamp.disable_tsc();
    pack_timestamps();
    @activate(EXIT);
  } else {
    @fmovs(recv_dsd, fab_in, .{ .async = true, .activate = RECV_DONE });
  }
}

task recv_done() void {
  local_sum_arr[0] += recv_arr[0];
  result_buf[0] = local_sum_arr[0];
  timestamp.get_timestamp(&tsc_end_buf);
  timestamp.disable_tsc();
  pack_timestamps();
  @activate(EXIT);
}

task f_exit() void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(f_exit, EXIT);
  @bind_local_task(recv_done, RECV_DONE);
  @export_symbol(ptr_x, "x");
  @export_symbol(ptr_result, "result");
  @export_symbol(ptr_timer_buf, "maxmin_time");
  @export_symbol(compute);
}
