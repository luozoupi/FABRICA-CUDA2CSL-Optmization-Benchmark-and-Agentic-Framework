<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>WSE-3 · Sparse dataflow</title>
<style>
:root{--ink:#293e51;--muted:#718391;--bg:#f5f5ef;--green:#098572;--soft:#e8f5ef;--line:#dbe4e5;--amber:#aa6818}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px system-ui,sans-serif;line-height:1.6}main{max-width:1400px;margin:auto;padding:36px}h1{font-size:44px;letter-spacing:-1.5px;font-weight:550;line-height:1.2;margin:14px 0}h2{font-size:22px;font-weight:600;margin:8px 0}h3{font-size:15px;margin:8px 0}p{margin:8px 0 16px}.eyebrow{font-size:11px;letter-spacing:2px;color:var(--green);font-weight:750}.muted,small{color:var(--muted)}.card{padding:24px;background:white;border:1px solid var(--line);border-radius:10px;margin:20px 0;min-width:0}.controls{display:flex;gap:15px;flex-wrap:wrap;align-items:end}.controls label{display:flex;flex-direction:column;font-size:11px;color:var(--muted);gap:5px}button,select{font:inherit;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:5px;padding:8px;cursor:pointer;max-width:100%}button:hover{border-color:var(--green)}.controls select{font-size:14px}button:disabled{opacity:.4;cursor:default}.badge{display:inline-block;background:var(--soft);color:var(--green);border-radius:4px;padding:4px 9px;font-size:12px}.badge.reconstructed{background:#fff0d6;color:var(--amber)}.two{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.25fr);gap:20px}.two>.card{margin:0}.stats{display:flex;gap:25px;flex-wrap:wrap}.stats b{font-size:24px;color:var(--green)}.stats small{display:block;font-size:11px}.clock{display:flex;gap:12px;align-items:center;margin:20px 0}.clock input{flex:1;accent-color:var(--green);min-width:50px}.clock b{min-width:90px;font-size:16px}svg{width:100%;height:auto;display:block}svg text{font:12px system-ui,sans-serif;fill:var(--ink)}.scroll{overflow:auto;max-width:100%}table{width:100%;border-collapse:collapse;font-size:12px}td,th{padding:7px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}th{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.5px}tr.active{background:var(--soft)}.equation{font-size:26px;color:var(--green);overflow-wrap:anywhere}.mono,code{font:12px ui-monospace,monospace;overflow-wrap:anywhere}.limit{background:#fff7e9;border-left:3px solid #d6993c;padding:10px 15px;font-size:12px}.snapshots{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:18px 0}.snapshot{border:1px solid var(--line);border-radius:7px;padding:14px;text-align:left;background:#fff;min-width:0}.snapshot.reached{background:var(--soft);border-color:var(--green)}.snapshot b{display:block;font-size:22px;color:var(--green);overflow-wrap:anywhere}.snapshot small{display:block;font-size:11px}.stages{display:flex;gap:6px;flex-wrap:wrap;margin:12px 0}.stages span{border:1px solid var(--line);border-radius:5px;padding:7px;font-size:12px}.numeric{font:13px ui-monospace,monospace}.proof{border:1px solid var(--line);padding:13px;border-radius:6px;margin:10px 0}.columns{display:grid;grid-template-columns:1fr 1fr;gap:12px;min-width:0}.column{min-width:0}.selected-entry{fill:var(--amber)}details{margin:15px 0}summary{cursor:pointer;font-size:12px}a{color:var(--green)}footer{font-size:12px;color:var(--muted);padding:24px 0}#sources{max-height:230px;overflow:auto}#step-table{max-height:380px}#evidence{max-width:1000px}.legend{font-size:11px;color:var(--muted)}
@media(max-width:900px){main{padding:16px}h1{font-size:33px}.two{grid-template-columns:1fr}.card{padding:16px}.snapshots{grid-template-columns:repeat(2,minmax(0,1fr))}.controls label{width:100%}.controls select{width:100%}.columns{grid-template-columns:1fr}.equation{font-size:23px}}
</style><main>
<header><span class="eyebrow">WSE-3 / SPARSE WORKLOADS</span><h1>Follow the nonzeros.</h1><p>Watch indices select operands, products update partial sums, and sparse structure decide which work happens.</p><span id="badge" class="badge"></span></header>
<section class="card"><div class="controls"><label>Workload / strategy<select id="scene"></select></label><label>Output row<select id="row"></select></label><label>Output column<select id="col"></select></label><button id="export">Export evidence</button></div><h2 id="title"></h2><p id="description"></p><div class="stats" id="stats"></div><p id="evidence" class="limit"></p><p id="timing" class="muted"></p></section>
<div class="two"><section class="card"><span class="eyebrow">SPARSE STRUCTURE</span><h2 id="matrix-title"></h2><svg id="matrix" viewBox="0 0 420 420" role="img" aria-label="Sparse matrix pattern and selected output"></svg><p class="legend" id="matrix-note"></p><h3>Where this output is computed</h3><svg id="mesh" viewBox="0 0 420 230" role="img" aria-label="Application PE ownership"></svg><p id="transport" class="muted"></p></section>
<section class="card"><span class="eyebrow">ONE OUTPUT, EVERY CONTRIBUTION</span><h2 id="output"></h2><div class="clock"><button id="prev" aria-label="Previous step">←</button><input id="step" type="range" min="0" aria-label="Completed steps"><button id="next" aria-label="Next step">→</button><b id="clock"></b></div><div class="stages" id="stages"></div><p id="pointer" class="mono"></p><div class="equation" id="equation"></div><p id="current"></p><div id="proof"></div><div class="scroll" id="verification"></div><p id="rounding" class="muted"><small>Displayed decimals are shortened; hover table values for exact numbers. Export retains full f32 values. Reconstructed arithmetic rounds the multiply and add separately; it does not establish the compiled instruction sequence.</small></p></section></div>
<section class="card"><span class="eyebrow">LAYERS OF THE SELECTED OUTPUT</span><h2>From an empty accumulator to a result.</h2><p id="slice-note" class="muted"></p><div id="snapshots" class="snapshots"></div><p class="legend">Each card shows the selected output's accumulator. These are not synchronized snapshots of every PE.</p></section>
<section class="card"><span class="eyebrow">INDEXED STORAGE</span><h2 id="storage-title"></h2><div id="storage"></div><h3>Step-by-step dataflow</h3><div class="scroll" id="step-table"></div><p id="empty-note" class="muted"></p></section>
<section class="card"><span class="eyebrow">ARTIFACTS AND CHECKS</span><h2>What is recorded, and what is reconstructed.</h2><p id="scope"></p><div id="regression"></div><details><summary>Source paths and SHA-256 identities</summary><div id="sources" class="mono"></div></details><p>To add cycle-level SpMM and SpGEMM views, retain small-run input/output arrays, intermediate values, placement, ELF/disassembly and simulator instruction traces together. A peer-hop view requires a kernel with actual application PE-to-PE communication.</p></section>
<footer>Offline HTML + SVG · <a href="../../SPARSE_VISUALIZATION.md">Sparse walkthrough guide</a> · <a href="../pe-hops/hops.html">Dense workload PE-hop viewer</a></footer></main>
<script id="sparse-data" type="application/json">__DATA__</script><script>
const DATA=JSON.parse(document.getElementById('sparse-data').textContent),$=id=>document.getElementById(id),esc=x=>String(x??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=x=>x==null?'—':Number.isInteger(x)?String(x):Number(x.toPrecision(7)).toString(),num=x=>`<span title="${esc(x)}">${fmt(x)}</span>`,hex=x=>'0x'+x.toString(16).padStart(8,'0');
const table=(hs,rows,selected=-1)=>`<table><thead><tr>${hs.map(h=>`<th>${esc(h)}</th>`).join('')}</tr></thead><tbody>${rows.map((r,i)=>`<tr class="${i===selected?'active':''}">${r.map(c=>`<td>${c}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
let scene=0,row=0,col=0,step=0;
const S=()=>DATA.scenes[scene],O=()=>S().outputs.find(o=>o.r===row&&o.c===col);
$('scene').innerHTML=DATA.scenes.map((s,i)=>`<option value="${i}">${s.title}</option>`).join('');
function chooseScene(){scene=+$('scene').value;const rows=[...new Set(S().outputs.map(o=>o.r))].sort((a,b)=>a-b);$('row').innerHTML=rows.map(r=>`<option value="${r}">${r}</option>`).join('');chooseRow();}
function chooseRow(){row=+$('row').value;const cols=S().outputs.filter(o=>o.r===row).map(o=>o.c).sort((a,b)=>a-b);$('col').innerHTML=cols.map(c=>`<option value="${c}">${c}</option>`).join('');chooseCol();}
function chooseCol(){col=+$('col').value;step=0;render();}
function instruction(label,e){return `<div class="proof"><b>${label} · cycle ${e.cycle}</b><p class="mono">${esc(e.assembly)}<br>UID ${e.uid} · PC ${hex(e.pc)} · S6 lane ${e.lane} · raw row ${e.row}<br>src0 ${hex(e.src0)} · src1 ${hex(e.src1)} · result ${hex(e.dest)}</p></div>`;}
function render(){const s=S(),o=O(),n=o.steps.length,q=o.steps[Math.max(0,step-1)],sparse=s.family==='SpGEMM',observed=s.mode==='recorded',acc=step?o.steps[step-1].acc:0;
$('badge').className='badge '+s.mode;$('badge').textContent=observed?'Recorded simulator operands + checked readback':'Source reconstruction · steps have no recorded cycles';$('title').textContent=s.title;$('description').textContent=s.description;$('evidence').textContent=s.evidence;$('timing').textContent=s.timing;
$('stats').innerHTML=`<div><b>${s.nnz}</b><small>stored nonzeros in A</small></div><div><b>${s.mesh[0]*s.mesh[1]}</b><small>application PEs</small></div><div><b>${s.outputs.length}</b><small>selectable outputs</small></div><div><b>${n}</b><small>${sparse?'pointer comparisons':'contributions'} for selected output</small></div>`;
$('matrix-title').textContent=s.matrix;$('matrix-note').textContent=sparse?'Each dot is a stored A entry and a requested output-mask position. Green columns supply the selected dot product; orange marks its mask position. Click a dot to inspect it.':'Each dot is a stored A entry. Green marks the selected sparse row. Click a dot to select its row.';
let svg='<rect x="35" y="20" width="365" height="365" fill="#f5f7f5" stroke="#dbe4e5"/><text x="35" y="410">row ↓ / column →</text>';
for(const [r,c] of s.coordinates){const selected=sparse?(r===row&&c===col):r===row,related=sparse&&(c===row||c===col);svg+=`<rect data-r="${r}" data-c="${c}" x="${35+c*365/s.m}" y="${20+r*365/s.n}" width="${Math.max(2,365/s.m-1)}" height="${Math.max(2,365/s.n-1)}" fill="${selected?(sparse?'#b76d18':'#098572'):related?'#098572':'#afc4c2'}"><title>A[${r},${c}]${sparse?' · mask output selectable':''}</title></rect>`;}$('matrix').innerHTML=svg;
$('matrix').querySelectorAll('[data-r]').forEach(e=>e.onclick=()=>{$('row').value=e.dataset.r;chooseRow();if(sparse){$('col').value=e.dataset.c;chooseCol();}});
let mesh='';const [px,py]=s.mesh;
for(let y=0;y<py;y++)for(let x=0;x<px;x++){const w=390/px,h=210/py,X=10+x*w,Y=8+y*h,active=x===o.pe[0]&&y===o.pe[1];mesh+=`<rect x="${X}" y="${Y}" width="${w-10}" height="${h-10}" rx="7" fill="${active?'#e8f5ef':'#f7f8f7'}" stroke="${active?'#098572':'#dbe4e5'}"/><text x="${X+12}" y="${Y+25}">PE (${x},${y})${active?' · selected':''}</text><text x="${X+12}" y="${Y+48}">rows ${y*s.rows_per_pe}…${Math.min(s.n,(y+1)*s.rows_per_pe)-1}</text><text x="${X+12}" y="${Y+68}">${s.family==='SpMM'?`C columns ${x*s.cols_per_pe}…${(x+1)*s.cols_per_pe-1}`:'local index / arithmetic work'}</text>`;}$('mesh').innerHTML=mesh;$('transport').textContent=s.transport;
$('output').textContent=`${s.family==='SpMV'?'y['+row+']':'C['+row+','+col+']'} · PE (${o.pe})`;$('step').max=n;$('step').value=step;$('prev').disabled=step===0;$('next').disabled=step===n;$('clock').textContent=`${step} / ${n} steps`;
$('stages').innerHTML=(sparse?['CSC column pointers','compare row indices','matched product','partial sum','mask row code']:['CSR row pointers','column index → gather',s.family==='SpMM'?'reuse A across B columns':'multiply','partial sum']).map(x=>`<span>${x}</span>`).join('');
$('pointer').textContent=sparse?`A(:,${row}): slots [${s.ptr[row]}, ${s.ptr[row+1]}); A(:,${col}): slots [${s.ptr[col]}, ${s.ptr[col+1]}); output mask slot ${o.mask_slot}`:`CSR row ${row}: [${s.ptr[row]}, ${s.ptr[row+1]})${q?' · selected global slot '+q.p:''}${q?.local_p!=null?' · PE-local slot '+q.local_p:''}${q?.storage_name?' · '+q.storage_name+'['+q.storage_p+']':''}`;
$('equation').textContent=step===0?'Accumulator starts at 0':q.match?`${fmt(q.old)} + ${fmt(q.a)} × ${fmt(q.b)} = ${fmt(q.acc)}`:`row ${q.ia} ≠ row ${q.ib} → ${q.action}`;
$('current').textContent=`Current accumulator: ${fmt(acc)}${step===n?' · selected output finished':''}${sparse&&step===n?' · '+(o.zombie?'no structural match; zombie':'structural match exists')+' · row code '+hex(o.row_code):''}`;
$('proof').innerHTML=step&&observed?instruction('Multiply',q.mul)+instruction('Add',q.add):observed?'<p class="muted">Advance to see the recorded multiply and add instructions.</p>':'<p class="limit">This is an arithmetic/index reconstruction. No PC, instruction cycle, SRAM access time or router event is assigned to this step.</p>';
$('verification').innerHTML=table(['Result kind','Final value'],[['Replayed arithmetic',num(o.result)],['Independent reference',num(o.reference)],['Retained device readback',o.observed==null?'not available per element':num(o.observed)]]);
$('slice-note').textContent=observed?'Cards use recorded Add S6 observations from this selected output. CSR/diagonal slot labels come from source indexing.':'Cards show logical progress in the reconstructed loop. SpMM outputs are inspected independently; this does not assert the scheduling order between PEs.';
const snapshots=[...new Set([0,Math.ceil(n/3),Math.ceil(2*n/3),n])];$('snapshots').innerHTML=snapshots.map(k=>`<button data-snapshot="${k}" class="snapshot ${k<=step?'reached':''}"><small>${k===0?'Initial':`After step ${k}`}</small><b>${fmt(k?o.steps[k-1].acc:0)}</b><small>PE (${o.pe}) · ${observed&&k?'cycle '+o.steps[k-1].add.cycle:'logical state'}</small></button>`).join('');document.querySelectorAll('[data-snapshot]').forEach(b=>b.onclick=()=>{step=+b.dataset.snapshot;render();});
$('storage-title').textContent=sparse?'Two CSC lists, one intersection.':'The sparse row and its gathered operands.';
if(sparse){$('storage').innerHTML='<div class="columns">'+[row,col].map((c,side)=>`<div class="column"><h3>A(:,${c}) · ${side?'right':'left'}</h3><div class="scroll">${table(['Slot','Row index','Value'],Array.from({length:s.ptr[c+1]-s.ptr[c]},(_,i)=>{const p=s.ptr[c]+i;return[p,s.idx[p],num(s.val[p])]}),q?(side?q.pb:q.pa)-s.ptr[c]:-1)}</div></div>`).join('')+'</div>';
$('step-table').innerHTML=table(['Step','Left slot / row','Right slot / row','Action','Product','Accumulator'],o.steps.map((t,i)=>[i+1,`${t.pa} / ${t.ia}`,`${t.pb} / ${t.ib}`,esc(t.action),num(t.product),num(t.acc)]),step-1);
}else{$('storage').innerHTML=`<div class="scroll">${table(['CSR slot','Column k','A[row,k]',s.family==='SpMV'?'x[k]':`B[k,${col}]`,'Product'],o.steps.map(t=>[t.p,t.k,num(t.a),num(t.b),num(t.product)]),step-1)}</div>`;
$('step-table').innerHTML=table(['Step','k','Old accumulator','Product','New accumulator','Multiply cycle','Add cycle'],o.steps.map((t,i)=>[i+1,t.k,num(t.old),num(t.product),num(t.acc),t.mul?.cycle??'unrecorded',t.add?.cycle??'unrecorded']),step-1);}
$('empty-note').textContent=n===0?'No contributions: the accumulator stays zero.':sparse?'Only matching row indices contribute. A structural match can exist even when numeric products cancel to zero.':s.family==='SpMM'?`Each A[row,k] also scales the other ${s.cols_per_pe-1} B values in this PE's output slice. Select another output column to inspect that reuse.`:'Absent matrix entries require no gather or multiply in this sparse loop.';
$('scope').textContent=s.evidence+' '+s.transport+(s.trace?' Raw record rows refer to '+s.trace+'.':'');
$('regression').innerHTML=s.regression?`<p class="limit">${esc(s.regression.label)}: row ${row} returned ${fmt(s.regression.observed[row])}, versus ${fmt(o.reference)}. ${esc(s.regression.note)}</p>`:'';
$('sources').innerHTML=s.sources.map(p=>`<p>${esc(p)}<br>${DATA.sources[p]}</p>`).join('');
}
$('scene').onchange=chooseScene;$('row').onchange=chooseRow;$('col').onchange=chooseCol;$('step').oninput=e=>{step=+e.target.value;render();};$('prev').onclick=()=>{step--;render();};$('next').onclick=()=>{step++;render();};$('export').onclick=()=>{const u=URL.createObjectURL(new Blob([JSON.stringify(DATA)],{type:'application/json'})),a=document.createElement('a');a.href=u;a.download='sparse-evidence.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);};chooseScene();
</script></html>
