// Cross-Entropy-Loss-1PE: single sample, n_classes classes.
// logits[n_classes] -> loss scalar.

param n_classes: u16;

const memcpy = @import_module("<memcpy/get_params>", .{ .width = 1, .height = 1 });

layout {
  @set_rectangle(1, 1);
  const memcpy_params = memcpy.get_params(0);
  @set_tile_code(0, 0, "pe.csl", .{
    .memcpy_params = memcpy_params,
    .n_classes = n_classes,
  });

  @export_name("logits", [*]f32, true);
  @export_name("label", [*]u32, true);
  @export_name("result", [*]f32, true);
  @export_name("maxmin_time", [*]f32, true);
  @export_name("compute", fn()void);
}
