// Histogram-Inline compute: per-PE local binning, no tally module.
// Each PE bins n_per_pe input elements. The host reads each PE's histogram
// and sums them — all coordination is visible and explicit.

param memcpy_params: comptime_struct;
param n_per_pe: u16;
param n_buckets: u16;
param bucket_size: u16;

const EXIT: local_task_id = @get_local_task_id(9);

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const timestamp = @import_module("<time>");

var tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);
var tsc_end_buf   = @zeros([timestamp.tsc_size_words]u16);
var timer_buf = @zeros([3]f32);
var ptr_timer_buf: [*]f32 = &timer_buf;

var input_array = @zeros([n_per_pe]u32);
var hist_local  = @zeros([n_buckets]u32);

var ptr_input: [*]u32 = &input_array;
var ptr_hist:  [*]u32 = &hist_local;

fn histogram() void {
  var b: u16 = 0;
  while (b < n_buckets) : (b += 1) {
    hist_local[b] = 0;
  }
  var i: u16 = 0;
  while (i < n_per_pe) : (i += 1) {
    const v: u32 = input_array[i];
    const bucket: u32 = (v / @as(u32, bucket_size)) % @as(u32, n_buckets);
    hist_local[bucket] += 1;
  }
}

fn compute() void {
  timestamp.enable_tsc();
  timestamp.get_timestamp(&tsc_start_buf);

  histogram();

  timestamp.get_timestamp(&tsc_end_buf);
  timestamp.disable_tsc();

  var lo_: u16 = 0;
  var hi_: u16 = 0;

  lo_ = tsc_start_buf[0];
  hi_ = tsc_start_buf[1];
  timer_buf[0] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  lo_ = tsc_start_buf[2];
  hi_ = tsc_end_buf[0];
  timer_buf[1] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  lo_ = tsc_end_buf[1];
  hi_ = tsc_end_buf[2];
  timer_buf[2] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  @activate(EXIT);
}

task f_exit() void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(f_exit, EXIT);

  @export_symbol(ptr_input, "input");
  @export_symbol(ptr_hist, "hist");
  @export_symbol(ptr_timer_buf, "maxmin_time");
  @export_symbol(compute);
}
