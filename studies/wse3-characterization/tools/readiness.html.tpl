<!doctype html>
<html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WSE-3 · Receiver readiness experiment</title>
<style>
:root{--ink:#293e51;--muted:#687d8d;--bg:#f5f5ef;--paper:#fff;--line:#dbe4e5;--green:#098572;--soft:#e8f5ef;--blue:#397da7;--amber:#b76d18}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:14px system-ui,sans-serif;line-height:1.6}main{max-width:1450px;margin:auto;padding:32px}h1{font-size:42px;letter-spacing:-1px;font-weight:550;margin:8px 0}h2{font-size:23px;font-weight:550;margin:6px 0}h3{font-size:15px}p{margin:8px 0 16px}.eyebrow{font-size:11px;font-weight:750;letter-spacing:2px;color:var(--green)}.muted,small{color:var(--muted)}.card{min-width:0;background:var(--paper);padding:22px;border:1px solid var(--line);border-radius:10px;margin:18px 0}.badge{display:inline-block;color:var(--green);background:var(--soft);padding:3px 9px;border-radius:4px;font-size:11px}.controls{display:flex;gap:14px;flex-wrap:wrap;align-items:end}.controls label{font-size:11px;display:flex;flex-direction:column;gap:5px;color:var(--muted)}select,button{font:inherit;background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:5px;padding:8px;cursor:pointer;max-width:100%}button:hover,button.active{border-color:var(--green);background:var(--soft);color:var(--green)}.stats{display:flex;gap:32px;flex-wrap:wrap;margin-bottom:18px}.stats b{font-size:24px;color:var(--green)}.stats small{display:block}.stage-layout{display:grid;grid-template-columns:minmax(0,1fr) 350px;gap:18px;align-items:start}.stage-layout>.card{margin:0}.stage{padding:18px;overflow:hidden}svg{width:100%;height:auto;display:block}svg text{font-family:system-ui,sans-serif;fill:var(--ink)}svg .tiny{font-size:11px;fill:var(--muted)}svg .number{font-family:ui-monospace,monospace;fill:var(--green);font-size:17px}svg .plane{fill:#f5faf8;stroke:var(--line)}svg .plane.active{fill:var(--soft);stroke:var(--green);stroke-width:2}svg .frame{cursor:pointer}svg .frame:focus-visible{outline:2px solid var(--amber)}.clock{display:flex;gap:12px;align-items:center;margin:16px 0}.clock input{flex:1;min-width:60px;accent-color:var(--green)}.clock b{font:23px ui-monospace,monospace}.rail{display:flex;gap:8px;flex-wrap:wrap}.rail button{font-size:11px;flex:1;min-width:85px;text-align:left}.rail b{display:block;font:17px ui-monospace,monospace}.words{display:flex;gap:5px;flex-wrap:wrap;margin:12px 0}.words button{font:12px ui-monospace,monospace;min-width:36px}.array{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}.cell{border:1px solid var(--line);border-radius:5px;padding:6px;background:#fafcfb;min-width:0}.cell small{display:block;font-size:10px}.cell b{font:12px ui-monospace,monospace;overflow-wrap:anywhere}.cell.selected{background:var(--soft);border-color:var(--green)}.scroll{overflow:auto;max-width:100%}table{width:100%;border-collapse:collapse;font-size:12px}th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}th{font-size:10px;text-transform:uppercase;color:var(--muted);letter-spacing:.4px}tbody tr.selected{background:var(--soft)}#comparison tbody tr{cursor:pointer}#comparison tbody tr:hover{background:#f1f8f5}.mono,code,pre{font:12px ui-monospace,monospace;overflow-wrap:anywhere}pre{white-space:pre-wrap;max-height:350px;overflow:auto}.note{border-left:3px solid var(--amber);padding:10px 15px;background:#fff7e9;font-size:12px}.equation{color:var(--green);font-size:19px;overflow-wrap:anywhere}.metrics{display:flex;gap:24px;flex-wrap:wrap;margin-top:15px}.metrics strong{font:23px ui-monospace,monospace;color:var(--green);display:block}.metrics small{font-size:11px}.legend{display:flex;gap:18px;flex-wrap:wrap;font-size:11px;color:var(--muted)}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;background:var(--green)}details{margin-top:16px}summary{cursor:pointer;font-size:12px}a{color:var(--green)}footer{padding:22px 0;font-size:12px;color:var(--muted)}
@media(max-width:1050px){.stage-layout{grid-template-columns:1fr}.array{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:650px){main{padding:14px}h1{font-size:31px}.card{padding:15px}.stage{padding:5px}.controls label{width:100%}.controls select{width:100%}.stats{gap:17px}.array{grid-template-columns:repeat(2,minmax(0,1fr))}.stage svg{min-height:400px}.rail button{min-width:75px}.metrics{gap:14px}}
.input-pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}.input-pair section{min-width:0}.input-pair .array{position:relative;grid-template-columns:1fr;max-height:225px;overflow:auto}.input-pair h3{font-size:12px}
</style>
<main>
<header><span class="eyebrow">WSE-3 / CONTROLLED PE EXPERIMENT 01</span><h1>When the receiver waits.</h1><p>One fixed route. Exact input words. A receiver whose delay changes while the sender stays the same.</p><span class="badge">Recorded simulator evidence</span> <span class="badge">Verified IR → ELF → instructions → values</span></header>
<section class="card"><div id="stats" class="stats"></div><div class="controls"><label>Capture<select id="case"></select></label><label>Numeric word<select id="word-select"></select></label><button id="export">Export evidence JSON</button></div><div id="words" class="words"></div><p id="treatment"></p><div id="metrics" class="metrics"></div></section>
<div class="stage-layout">
<section class="card stage"><span class="eyebrow">VALUE LINEAGE THROUGH TIME</span><h2>Two PEs, five observed moments.</h2><svg id="layers" viewBox="0 0 800 655" role="img" aria-label="Two-PE dataflow across five recorded time layers"></svg><div class="clock"><button id="prev" aria-label="Previous observation">←</button><input id="cycle" type="range" aria-label="Simulator cycle"><button id="next" aria-label="Next observation">→</button><b id="clock"></b></div><div id="rail" class="rail"></div><p class="muted"><small>Planes are sampled at the selected word’s observations; vertical spacing is not proportional to elapsed time. Dashed links connect observations, without inventing in-flight packet positions.</small></p></section>
<aside class="card"><span class="eyebrow">INPUTS BESIDE THE MESH</span><h2 id="input-title"></h2><p id="bit-pattern" class="mono"></p><div class="input-pair"><section><h3>PE (0,0)<br>Input buf[]</h3><div id="payload" class="array"></div></section><section><h3>PE (1,0)<br>Input loc[]</h3><div id="local" class="array"></div></section></div><p class="muted"><small>Host-loaded before run(). Arrays scroll; the selected slot is highlighted.</small></p><div class="input-pair"><section><h3>PE (1,0)<br>Received by cycle</h3><div id="received" class="array"></div></section><section><h3>PE (1,0)<br>Results by cycle</h3><div id="outputs" class="array"></div></section></div><p id="equation" class="equation"></p><p class="note">A receive S6 record establishes an operand value. It does not timestamp an SRAM write or reveal queue occupancy.</p></aside>
</div>
<section class="card"><span class="eyebrow">SAME MESSAGE LENGTH / SAME SENDER</span><h2>What shifts when readiness changes?</h2><p id="chart-note" class="muted"></p><svg id="timing" role="img" aria-label="Delay treatments aligned to sender dispatch"></svg><div class="legend"><span><i class="dot" style="background:#b76d18"></i>First receive dispatch</span><span><i class="dot" style="background:#397da7"></i>First–last source-router observation</span><span><i class="dot"></i>Last Add result</span></div><p class="note">Receive dispatch can precede data and occur again when the operation resumes. The chart retains the first dispatch; the instruction inspector lists every dispatch.</p></section>
<section class="card"><span class="eyebrow">ALL RETAINED TREATMENTS</span><h2>Compare measured intervals.</h2><p>Click a row to inspect its exact words. Δ columns compare with delay 0 in the same build group; all units are simulator cycles.</p><div id="comparison" class="scroll"></div><p id="repeats" class="muted"></p></section>
<section class="card"><span class="eyebrow">SELECTED WORD / AUDIT TRAIL</span><h2 id="audit-title"></h2><div id="intervals" class="scroll"></div><p id="source" class="mono"></p><details><summary>Instructions, all dispatches, packet identity and raw rows</summary><pre id="raw"></pre></details><details><summary>Verified delay instructions and executed IR</summary><pre id="delay-audit"></pre></details><details><summary>Scope and interpretation</summary><ul id="limits"></ul></details></section>
<footer>Offline HTML + SVG · <a href="../../microbench/readiness/README.md">Experiment and reproduction</a> · <a href="../pe-hops/hops.html">GEMM/GEMV hop evidence</a></footer>
</main>
<script type="application/json" id="readiness-data">__READINESS_DATA__</script>
<script>
'use strict';
const DATA=JSON.parse(document.getElementById('readiness-data').textContent),$=id=>document.getElementById(id);
const esc=x=>String(x??'—').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const hex=x=>'0x'+x.toString(16).padStart(8,'0'),num=x=>x==null?'?':Number(x.toPrecision(8)).toString(),signed=x=>(x>0?'+':'')+x;
const table=(headers,rows)=>`<table><thead><tr>${headers.map(x=>`<th>${esc(x)}</th>`).join('')}</tr></thead><tbody>${rows.join('')}</tbody></table>`;
let ci=Math.max(0,DATA.cases.findIndex(c=>c.words===16&&c.receiver_nops===256)),slot=0,cycle=0;
$('stats').innerHTML=`<div><b>${DATA.cases.length}</b><small>verified executions</small></div><div><b>${DATA.cases.reduce((s,c)=>s+c.words,0)}</b><small>words bound end to end</small></div><div><b>${[...new Set(DATA.cases.map(c=>c.words))].join(' / ')}</b><small>message lengths</small></div>`;
$('case').innerHTML=DATA.cases.map((c,i)=>`<option value="${i}">${c.words} words · delay ${c.receiver_nops} · trial ${c.repeat+1} · ${esc(c.group)}</option>`).join('');
$('limits').innerHTML=DATA.limits.map(x=>`<li>${esc(x)}</li>`).join('');
function arrayHTML(c,key,stage){return c.terms.map(t=>{const known=stage==null||cycle>=t.events[stage].cycle;return `<div class="cell ${t.slot===slot?'selected':''}" title="${esc(known?`${key}[${t.slot}] = ${t[key]} (${hex(t[key==='value'?'bits':key+'_bits'])})`:'No observation yet')}"><small>[${t.slot}]</small><b>${known?num(t[key]):'?'}</b></div>`;}).join('');}
function chooseCase(){ci=+$('case').value;const c=DATA.cases[ci];slot=Math.min(slot,c.words-1);$('word-select').innerHTML=c.terms.map(t=>`<option value="${t.slot}">[${t.slot}] = ${num(t.value)}</option>`).join('');chooseWord(slot);}
function chooseWord(s){slot=s;$('word-select').value=String(slot);const t=DATA.cases[ci].terms[slot];cycle=t.events[2].cycle;render();}
function render(){const c=DATA.cases[ci],t=c.terms[slot],events=t.events,times=events.map(e=>e.cycle);
 $('case').value=String(ci);$('clock').textContent=cycle;$('cycle').min=times[0];$('cycle').max=times[4];$('cycle').value=cycle;
 $('words').innerHTML=c.terms.map(q=>`<button data-slot="${q.slot}" class="${q.slot===slot?'active':''}" aria-label="Word ${q.slot}">[${q.slot}]</button>`).join('');
 $('words').querySelectorAll('button').forEach(b=>b.onclick=()=>chooseWord(+b.dataset.slot));
 $('treatment').textContent=`PE (0,0) → PE (1,0), fabric (4,1) → (5,1), color 6. Sender: ${c.sender_nops} verified NOPs. Receiver: ${c.receiver_nops} verified NOPs. All input, receive and output bits agree.`;
 $('metrics').innerHTML=`<div><strong>${signed(c.metrics.readiness_offset)}</strong><small>first receive − send dispatch</small></div><div><strong>${Math.min(...c.metrics.router_intervals)}–${Math.max(...c.metrics.router_intervals)}</strong><small>router observation intervals</small></div><div><strong>${signed(c.delta.send_to_last_use)}</strong><small>Δ send-to-last-Add duration</small></div>`;
 $('input-title').textContent=`Word [${slot}] · cycle ${cycle}`;$('bit-pattern').textContent=`${t.value} · ${hex(t.bits)}`;
 $('payload').innerHTML=arrayHTML(c,'value');$('local').innerHTML=arrayHTML(c,'local');$('received').innerHTML=arrayHTML(c,'value',3);$('outputs').innerHTML=arrayHTML(c,'output',4);
 for(const id of ['payload','local','received','outputs']){const grid=$(id),selected=grid.querySelector('.selected');grid.scrollTop=selected.offsetTop-grid.clientHeight/2+selected.clientHeight/2;}
 $('equation').textContent=cycle>=times[4]?`${num(t.value)} + ${num(t.local)} = ${num(t.output)}`:'Add result not yet observed';
 $('rail').innerHTML=events.map((e,i)=>`<button data-event="${i}" class="${cycle===e.cycle?'active':''}">${e.label}<b>${e.cycle}</b></button>`).join('');
 $('rail').querySelectorAll('button').forEach(b=>b.onclick=()=>{cycle=events[+b.dataset.event].cycle;render();});
 let svg=`<text x="20" y="25" class="tiny">TIME ↓</text><text x="238" y="25">PE (0,0) · sender</text><text x="498" y="25">PE (1,0) · receiver</text>`;
 for(let i=0;i<4;i++){const y=65+i*120;svg+=`<path d="M300 ${y+64} L300 ${y+184} M565 ${y+64} L565 ${y+184}" fill="none" stroke="#93b9ae" stroke-dasharray="4 5"/>`;}
 events.forEach((e,i)=>{const y=65+i*120,received=e.cycle>=times[3],used=e.cycle>=times[4];
  svg+=`<g class="frame" data-layer="${i}" role="button" tabindex="0" aria-label="${e.label}, cycle ${e.cycle}"><path class="plane ${cycle===e.cycle?'active':''}" d="M130 ${y-8} L692 ${y-8} L754 ${y+74} L192 ${y+74} Z"/><text x="10" y="${y+17}" font-size="12">${e.label}</text><text x="10" y="${y+37}" class="number">${e.cycle}</text><rect x="219" y="${y+3}" width="192" height="59" rx="6" fill="white" stroke="#c7dcd4"/><text x="230" y="${y+22}" class="tiny">buf[${slot}] · initial input</text><text x="230" y="${y+46}" class="number">${num(t.value)}</text><rect x="475" y="${y+3}" width="221" height="59" rx="6" fill="white" stroke="#c7dcd4"/><text x="486" y="${y+22}" class="tiny">${used?'res['+slot+'] · Add result':received?'buf['+slot+'] · received operand':i===2?'same word at router':'loc['+slot+'] = '+num(t.local)}</text><text x="486" y="${y+46}" class="number">${used?num(t.output):received||i===2?num(t.value):'received: ?'}</text></g>`;
 });
 svg+=`<path d="M411 220 L475 328" fill="none" stroke="#397da7" stroke-width="2" stroke-dasharray="5 4"/><text x="411" y="263" class="tiny">${t.intervals[1]} cyc</text>`;
 $('layers').innerHTML=svg;$('layers').querySelectorAll('[data-layer]').forEach(g=>{const pick=()=>{cycle=events[+g.dataset.layer].cycle;render();};g.onclick=pick;g.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();pick();}};});
 const peers=DATA.cases.filter(r=>r.group===c.group&&r.words===c.words),low=Math.min(-20,...peers.map(r=>r.metrics.readiness_offset))-10,high=Math.max(...peers.map(r=>r.metrics.send_to_last_use))+15;
 const x=v=>165+(v-low)/(high-low)*585,H=peers.length*52+48;
 $('timing').setAttribute('viewBox',`0 0 800 ${H}`);let chart=`<path d="M${x(0)} 10 V${H-23}" stroke="#ccd8dd" stroke-dasharray="3 3"/>`;
 peers.forEach((r,i)=>{const y=29+i*52,m=r.metrics;chart+=`<text x="5" y="${y+5}" font-size="12">delay ${r.receiver_nops} · trial ${r.repeat+1}</text><path d="M${x(low)} ${y} H${x(high)}" stroke="#edf0f0"/><path d="M${x(m.source_first-m.send_dispatch)} ${y} H${x(m.source_last-m.send_dispatch)}" stroke="#397da7" stroke-width="7"/><circle cx="${x(m.source_first-m.send_dispatch)}" cy="${y}" r="4" fill="#397da7"/><circle cx="${x(m.readiness_offset)}" cy="${y}" r="5" fill="#b76d18"/><circle cx="${x(m.send_to_last_use)}" cy="${y}" r="5" fill="#098572"/><text x="${x(m.send_to_last_use)+9}" y="${y+4}" class="tiny">${m.send_to_last_use}</text>`;});
 chart+=`<text x="${x(0)-4}" y="${H-2}" class="tiny">0 = send dispatch</text>`;$('timing').innerHTML=chart;
 $('chart-note').textContent=`${c.words} words · ${c.group}. All rows use byte-identical sender ELFs. Horizontal positions are proportional to cycles relative to each run’s first send dispatch.`;
 $('comparison').innerHTML=table(['Words','Receiver NOPs','Trial / group','Receive − send','Router min–max','Max landing → receive','Last Add − send','Δ receive dispatch','Δ duration'],DATA.cases.map((r,i)=>`<tr data-case="${i}" class="${i===ci?'selected':''}"><td>${r.words}</td><td>${r.receiver_nops}</td><td>${r.repeat+1} / ${esc(r.group)}</td><td>${signed(r.metrics.readiness_offset)}</td><td>${Math.min(...r.metrics.router_intervals)}–${Math.max(...r.metrics.router_intervals)}</td><td>${Math.max(...r.metrics.landing_to_receive)}</td><td>${r.metrics.send_to_last_use}</td><td>${signed(r.delta.receive_dispatch)}</td><td>${signed(r.delta.send_to_last_use)}</td></tr>`));
 $('comparison').querySelectorAll('[data-case]').forEach(tr=>tr.onclick=()=>{$('case').value=tr.dataset.case;chooseCase();});
 $('repeats').textContent=DATA.repeats.map(r=>`${r.words} words / delay ${r.receiver_nops}: ${r.count} repetitions, ${r.timing_and_values_identical?'identical word values and observation cycles':'timing differences observed'}.`).join(' ');
 $('audit-title').textContent=`Word [${slot}] = ${t.value}`;
 $('intervals').innerHTML=table(['Observation','Cycle','Δ from previous','PE','Raw JSONL row'],events.map((e,i)=>`<tr class="${cycle===e.cycle?'selected':''}"><td>${e.label}</td><td>${e.cycle}</td><td>${i?t.intervals[i-1]:'—'}</td><td>${e.pe}</td><td>${e.row}</td></tr>`));
 $('source').textContent=`${c.source}/events.jsonl.gz · packet ident ${t.packet.ident} · ${hex(t.bits)} · rows are 1-based decompressed JSONL lines.`;
 $('raw').textContent=JSON.stringify({packet:t.packet,send:c.transfers.send,receive:c.transfers.receive,add:c.arithmetic},null,2);
 $('delay-audit').textContent=JSON.stringify({executed_ir:c.executed_ir,delay_checks:c.delay_checks,run_assembly:c.run_assembly},null,2);
 $('prev').disabled=!times.some(x=>x<cycle);$('next').disabled=!times.some(x=>x>cycle);
}
$('case').onchange=chooseCase;$('word-select').onchange=e=>chooseWord(+e.target.value);$('cycle').oninput=e=>{cycle=+e.target.value;render();};
for(const [id,sign] of [['prev',-1],['next',1]])$(id).onclick=()=>{const ts=DATA.cases[ci].terms[slot].events.map(e=>e.cycle).filter(t=>sign*(t-cycle)>0).sort((a,b)=>sign*(a-b));if(ts.length){cycle=ts[0];render();}};
$('export').onclick=()=>{const u=URL.createObjectURL(new Blob([JSON.stringify(DATA,null,2)],{type:'application/json'})),a=document.createElement('a');a.href=u;a.download='readiness-evidence.json';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);};
$('case').value=String(ci);chooseCase();
</script></html>
