// RowScale-CSR compute (hand-written reference): Row scaling of a sparse matrix in CSR
//
// Textbook scalar translation of the GraphBLAS-derived CUDA kernel (CUDA/kernel.cu); the
// structure-aware and hardware-aware rewrites are the optimizer's job. Timed with the
// hardware TSC over `iters` repeats inside the frozen `compute()` wrapper, so cycles_send
// measures exactly the kernel function. SDK 2.10-native syntax (untyped memcpy params);
// compiles on SDK 1.4 as well.

param memcpy_params;

param nrows: u16;
param max_nnz: u16;
param iters: u16;

const EXIT: local_task_id = @get_local_task_id(9);  // leave RPC after compute

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);

const timestamp = @import_module("<time>");
var tsc_start_buf = @zeros([timestamp.tsc_size_words]u16);
var tsc_end_buf   = @zeros([timestamp.tsc_size_words]u16);

// timer_buf packs the 6 u16 tsc words into 3 f32 for the host (STM convention).
var timer_buf = @zeros([3]f32);
var ptr_timer_buf: [*]f32 = &timer_buf;

// Sparse storage + vectors (host fills these via memcpy_h2d; arrays are zero-padded to the caps).
var row_ptr_array = @zeros([nrows + 1]u32);
var val_array     = @zeros([max_nnz]f32);
var d_array       = @zeros([nrows]f32);
var c_val_array   = @zeros([max_nnz]f32);

var ptr_row_ptr: [*]u32 = &row_ptr_array;
var ptr_val:     [*]f32 = &val_array;
var ptr_d:       [*]f32 = &d_array;
var ptr_c_val:   [*]f32 = &c_val_array;

// One pass: c_val[j] = d[r] * val[j] for the nonzeros of row r.
fn rowscale() void {
  var r: u16 = 0;
  while (r < nrows) : (r += 1) {
    const start: u32 = row_ptr_array[r];
    const end:   u32 = row_ptr_array[r + 1];
    const dr: f32 = d_array[r];
    var j: u32 = start;
    while (j < end) : (j += 1) {
      c_val_array[j] = dr * val_array[j];
    }
  }
}

// FROZEN wrapper (contract): timed window around the kernel function, packs the timestamps.
fn compute() void {
  timestamp.enable_tsc();
  timestamp.get_timestamp(&tsc_start_buf);

  for (@range(u16, iters)) |_| {
    rowscale();
  }

  timestamp.get_timestamp(&tsc_end_buf);
  timestamp.disable_tsc();

  // Pack the two 3-word u16 timestamps into 3 f32 (lo|hi per word pair) -- STM layout.
  var lo_: u16 = 0;
  var hi_: u16 = 0;

  lo_ = tsc_start_buf[0];
  hi_ = tsc_start_buf[1];
  timer_buf[0] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  lo_ = tsc_start_buf[2];
  hi_ = tsc_end_buf[0];
  timer_buf[1] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  lo_ = tsc_end_buf[1];
  hi_ = tsc_end_buf[2];
  timer_buf[2] = @bitcast(f32, (@as(u32, hi_) << @as(u16, 16)) | @as(u32, lo_));

  @activate(EXIT);
}

task f_exit() void {
  sys_mod.unblock_cmd_stream();
}

comptime {
  @bind_local_task(f_exit, EXIT);

  @export_symbol(ptr_row_ptr, "row_ptr");
  @export_symbol(ptr_val, "val");
  @export_symbol(ptr_d, "d");
  @export_symbol(ptr_c_val, "c_val");
  @export_symbol(ptr_timer_buf, "maxmin_time");
  @export_symbol(compute);
}
